{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id,\n            p.lote_id,\n            p.data,\n            p.peso_medio::float8 AS \"peso_medio!\"\n        FROM pesagens p\n        JOIN lotes l ON l.id = p.lote_id\n        WHERE p.lote_id = $1\n          AND l.usuario_id = $2\n        ORDER BY p.data\n        ",
