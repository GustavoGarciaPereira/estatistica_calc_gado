{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.id,\n            c.lote_id,\n            c.data,\n            c.tipo,\n            c.valor::float8 AS \"valor!\"\n        FROM custos c\n        JOIN lotes l ON l.id = c.lote_id\n        WHERE c.lote_id = $1\n          AND l.usuario_id = $2\n        ORDER BY c.data\n        ",
